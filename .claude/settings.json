{
  "permissions": {
    "allow": [
      "Bash(unzip:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "maya-env": "off",
    "maya-dev": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "vercel-plugin@vercel": false,
    "engineering@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false,
    "diagram-design@diagram-design": true,
    "cache-clock@ddc": true,
    "decision-tree@ddc": true,
    "diagram-pane@ddc": true
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "source": "github",
        "repo": "cathrynlavery/diagram-design"
      }
    },
    "ddc": {
      "source": {
        "source": "directory",
        "path": "/home/ddecastro/workspace/github.com/mindless-scribbles/claude-project-templates"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": false,
  "skipAutoPermissionPrompt": true
}
