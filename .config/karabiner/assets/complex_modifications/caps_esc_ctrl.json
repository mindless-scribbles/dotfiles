{
  "title": "Caps Lock → Esc (tap) / Control (hold)",
  "rules": [
    {
      "description": "Caps Lock: tap = Escape, hold = Left Control",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }],
          "to_if_alone": [{ "key_code": "escape" }]
        }
      ]
    }
  ]
}
